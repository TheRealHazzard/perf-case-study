{
  "name": "perf-case-study",
  "version": "1.0.0",
  "private": true,
  "description": "A deliberately slow Next.js page, fixed step by step with measured Lighthouse results",
  "scripts": {
    "images": "node scripts/generate-images.mjs",
    "dev": "npm run images && next dev",
    "build": "npm run images && next build",
    "start": "next start -p 4100",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.3"
  }
}
